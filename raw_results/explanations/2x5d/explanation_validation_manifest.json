{
  "scoring_version": "structured_detection_v7",
  "model": "gpt-5.6-luna",
  "detection_pos": 25,
  "detection_neg": 25,
  "bootstrap_replicates": 2000,
  "run_llm_detection_controls": true,
  "primary_condition": "natural-language explanation + frozen selected target + generation-normalized held-out target percentile",
  "activation_support_definition": "TopKSAE post-ReLU coefficient z > 0; no tunable epsilon",
  "validation_scope": "balanced held-out fidelity benchmark; no pass/fail threshold",
  "api_baselines": [
    "explanation_only",
    "target_only",
    "shuffled_explanation",
    "frequency_matched_dummy"
  ],
  "local_baselines": [
    "always_active",
    "random_prediction"
  ],
  "phase3_handoff": {
    "target_source": "P2-2 frozen selected target",
    "direction_source": "sign of P2-1 focal_max_generation Spearman rho for the selected target",
    "direction_validated_here": false
  },
  "blinding_policy": {
    "included_in_primary_scorer": [
      "explanation",
      "selected target definition",
      "generation-normalized selected target percentile",
      "auction description",
      "bidder index",
      "item index"
    ],
    "excluded_from_scorer": [
      "feature id",
      "activation value and label",
      "generation rho",
      "predicted direction",
      "the six unselected targets"
    ]
  },
  "files": {
    "explanation_validation": "explanation_validation.parquet",
    "detection_judgments": "detection_judgments.jsonl"
  }
}
